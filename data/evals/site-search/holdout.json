{
  "version": 1,
  "set": "holdout",
  "description": "Held-out site-search queries, written after the ranking in lib/siteSearch.ts was tuned on queries.json and scored once without further tuning. Leans on synonyms and everyday wording the maps may not use ('rent caps', 'global warming', 'capital punishment'), so it shows where lexical search stops. Same format and scoring as queries.json. The five `no-map` cases were added on 2026-10-06 after the r6 search changes and scored once.",
  "cases": [
    { "query": "should nuclear plants be built", "expected": ["nuclear-energy-safety"], "kind": "question" },
    { "query": "rent caps", "expected": ["rent-control-effectiveness"], "kind": "synonym" },
    { "query": "raising the minimum wage", "expected": ["minimum-wage-effects"], "kind": "phrase" },
    { "query": "robots replacing workers", "expected": ["ai-mass-unemployment"], "kind": "synonym" },
    { "query": "global warming", "expected": ["climate-change"], "kind": "synonym" },
    { "query": "assault weapons ban", "expected": ["gun-control-effectiveness"], "kind": "synonym" },
    { "query": "capital punishment", "expected": ["death-penalty-deterrence"], "kind": "synonym" },
    { "query": "basic income", "expected": ["universal-basic-income"], "kind": "keyword" },
    { "query": "do immigrants lower wages", "expected": ["immigration-wage-impact"], "kind": "question" },
    { "query": "national popular vote", "expected": ["electoral-college-reform"], "kind": "keyword" },
    { "query": "instagram teen depression", "expected": ["social-media-mental-health"], "kind": "keyword" },
    { "query": "where did covid come from", "expected": ["lab-leak-theory"], "kind": "question" },
    { "query": "is a degree worth it", "expected": ["college-value-proposition"], "kind": "question" },
    { "query": "weight loss drugs", "expected": ["glp1-weight-loss-drugs"], "kind": "keyword" },
    { "query": "bitcoin", "expected": ["cryptocurrency-value", "cryptocurrency-regulation"], "kind": "keyword" },
    { "query": "cancel culture", "expected": ["cancel-culture"], "kind": "keyword" },
    { "query": "is eating meat bad for the planet", "expected": ["veganism-environmental-impact", "factory-farming-ban"], "kind": "question" },
    { "query": "are robotaxis safe", "expected": ["self-driving-car-safety"], "kind": "synonym" },
    { "query": "chatgpt as a therapist", "expected": ["ai-therapy-chatbots"], "kind": "phrase" },
    { "query": "daylight savings", "expected": ["daylight-saving-time-abolition"], "kind": "misspelling" },
    { "query": "tipping", "expected": ["tipping-culture"], "kind": "keyword" },
    { "query": "is there free will", "expected": ["free-will"], "kind": "question" },
    { "query": "simulation theory", "expected": ["simulation-hypothesis"], "kind": "keyword" },
    { "query": "carbon capture", "expected": ["carbon-capture-viability"], "kind": "keyword" },
    { "query": "work from home", "expected": ["remote-work-permanence", "return-to-office-productivity"], "kind": "phrase" },
    { "query": "deepfakes", "expected": ["ai-deepfakes-truth-collapse"], "kind": "keyword" },
    { "query": "term limits for congress", "expected": ["congressional-term-limits"], "kind": "phrase" },
    { "query": "sports betting", "expected": ["sports-betting-legalization"], "kind": "keyword" },
    { "query": "russia ukraine peace deal", "expected": ["ukraine-peace-terms"], "kind": "phrase" },
    { "query": "is the death penalty fair", "expected": ["death-penalty-deterrence"], "kind": "question" },
    { "query": "pineapple on pizza", "expected": [], "maxMaps": 0, "kind": "no-map" },
    { "query": "should we keep the monarchy", "expected": [], "maxMaps": 0, "kind": "no-map" },
    { "query": "my coworker keeps taking credit for my work", "expected": [], "maxMaps": 2, "kind": "no-map" },
    { "query": "should i break up with my boyfriend", "expected": [], "maxMaps": 2, "kind": "no-map" },
    { "query": "is abortion murder", "expected": [], "maxMaps": 0, "kind": "no-map" }
  ]
}
