    {
      "id": "covid-what-ended:c-vaccines-cut-severe-disease:2020-12-10:1",
      "topicId": "covid-what-ended",
      "claimId": "c-vaccines-cut-severe-disease",
      "date": "2020-12-10",
      "noticedAt": "2026-09-22",
      "status": "narrowed",
      "resolutionKind": "existing-evidence",
      "evidenceNodeIds": [
        "e-bnt162b2-phase3"
      ],
      "note": "Phase III trial: 95% efficacy against symptomatic Covid; severe cases after dose 1 were 9 on placebo, 1 on vaccine. Powered for symptomatic disease, so severe counts were small.",
      "author": {
        "kind": "editorial",
        "curator": "argumend-editorial",
        "basis": "docs/research/2026-09-22-covid-crux-retrospective.md row 2, fact-checked 2026-09-22"
      },
      "createdAt": "2026-09-22"
    },
