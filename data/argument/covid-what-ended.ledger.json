      "noticedAt": "2026-09-22",
      "status": "narrowed",
      "resolutionKind": "existing-evidence",
      "evidenceNodeIds": [
        "e-alpha-delta-onward-transmission"
      ],
      "note": "Two doses cut onward transmission of Alpha (rate ratio 0.32) and Delta (0.50), the Delta effect fading within about 12 weeks. Real and time-limited; the threshold for compulsion is untouched.",
      "author": {
        "kind": "editorial",
        "curator": "argumend-editorial",
        "basis": "docs/research/2026-09-22-covid-crux-retrospective.md row 3, fact-checked 2026-09-22"
      },
      "createdAt": "2026-09-22"
    },
