# Offline mode is the default. Leave optional services blank until you intend
# to enable them; copying this file must not trigger database or provider calls.

# Database (optional Postgres persistence)
DATABASE_URL=

# LLM API keys (optional; GOOGLE_AI_API_KEY/GEMINI_API_KEY and
# XAI_API_KEY/GROK_API_KEY are accepted aliases)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
GROK_API_KEY=

# Live model-backed features are opt-in. The matching NEXT_PUBLIC flag exposes
# the mode in the browser; the server flag authorizes the corresponding API.
ENABLE_LIVE_ANALYZE_API=false
NEXT_PUBLIC_ENABLE_LIVE_ANALYZE_API=false
ENABLE_LIVE_DEBATE_API=false
NEXT_PUBLIC_ENABLE_LIVE_DEBATE_API=false
ENABLE_LIVE_JUDGING_API=false
NEXT_PUBLIC_ENABLE_LIVE_JUDGING_API=false

# Disagreement Diagnosis V2 is opt-in. Copying this file must keep it off.
ENABLE_DISAGREEMENT_V2=false
NEXT_PUBLIC_ENABLE_DISAGREEMENT_V2=false
# anthropic = hosted API (needs ANTHROPIC_API_KEY)
# cli       = local subscription-backed CLI, refused in production (no API key)
# fake      = canned fixtures, for tests
ARGUMEND_DISAGREEMENT_PROVIDER=anthropic
ARGUMEND_DISAGREEMENT_MODEL=
ARGUMEND_DISAGREEMENT_MAX_OUTPUT_TOKENS=6000
# Only read when ARGUMEND_DISAGREEMENT_PROVIDER=cli
ARGUMEND_DISAGREEMENT_CLI=claude
ARGUMEND_DISAGREEMENT_CLI_BIN=
ENABLE_DISAGREEMENT_PUBLISHING=false
REPORT_PUBLICATION_SECRET=

# Jev map reply (TypeSafe AI). Off by default, and it must stay off unless the
# third-party disclosure below is acceptable for your deployment: the live lane
# POSTS THE TEXT THE USER PASTED to https://api.typesafe.ai, a third party, with
# emails, phone numbers and @handles redacted and speakers renamed first.
# It is for text the user pastes themselves, never for scraped community
# comments. See docs/MAP_REPLY.md.
ENABLE_JEV_MAP_REPLY=false
TYPESAFE_API_KEY=
# Pinned model id. Aliases such as jev-latest move without notice and every
# threshold in lib/mapReply was tuned against this version.
JEV_MODEL=jev-1.13.0
# Per-process, per-UTC-day input+output token ceiling for the Jev lane.
JEV_DAILY_TOKEN_CEILING=5000000
# http = live TypeSafe API (needs the key), fake = canned fixtures.
# Blank picks http when the flag is on and a key is set, fake otherwise.
ARGUMEND_JEV_PROVIDER=
# Confidence a topic Choice must clear before a map is shown (0-1).
MAP_REPLY_TOPIC_CONFIDENCE=0.5

# Auth.js (NextAuth v5)
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
# Required when auth is enabled behind a reverse proxy (Coolify/Cloudflare)
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Enable only after auth credentials and DATABASE_URL are configured.
NEXT_PUBLIC_ENABLE_AUTH=false

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Moltbook (optional)
MOLTBOOK_API_KEY=
