{
  "name": "argumend",
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "description": "AI-powered argument mapping for contentious topics.",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "start": "node .next/standalone/server.js",
    "smoke:standalone": "node scripts/smoke-standalone.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:sources": "tsx scripts/check-source-urls.ts",
    "eval:disagreement": "tsx scripts/eval-disagreement.ts",
    "eval:disagreement:live": "DISAGREEMENT_LIVE_EVAL=true tsx scripts/eval-disagreement.ts",
    "corpus:disagreement": "tsx scripts/disagreement/run-corpus.ts",
    "corpus:disagreement:live": "tsx scripts/disagreement/run-corpus.ts --provider cli",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "analyze": "ANALYZE=true bun --bun next build"
  },
  "keywords": [
    "ai",
    "argument-mapping",
    "discourse",
    "debate",
    "llm"
  ],
  "author": "Amir H. Jalali",
  "license": "ISC",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@auth/drizzle-adapter": "^1.11.3",
    "@google/generative-ai": "^0.24.1",
    "@xyflow/react": "^12.9.3",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.23.24",
    "katex": "^0.16.25",
    "lucide-react": "^0.555.0",
    "minisearch": "^7.2.0",
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "openai": "^6.49.0",
    "postgres": "^3.4.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-katex": "^3.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "^16.3.2",
    "@types/katex": "^0.16.8",
    "@types/node": "20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "4.1.2",
    "autoprefixer": "^10.5.4",
    "baseline-browser-mapping": "^2.8.32",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "happy-dom": "^20.5.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.2"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "$postcss",
    "sharp": "^0.35.3",
    "ws": "^8.21.1"
  }
}
